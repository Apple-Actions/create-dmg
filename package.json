{
  "name": "create-dmg-action",
  "version": "1.0.0",
  "description": "GitHub Action to package a Developer ID macOS .app into a signed DMG ready for notarization.",
  "type": "module",
  "main": "src/main.ts",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/index.js --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\"",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "knip": "knip",
    "lint": "eslint",
    "test": "vitest run",
    "type:check": "tsc --noEmit",
    "all": "yarn format && yarn knip && yarn lint && yarn type:check && yarn test && yarn build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Apple-Actions/create-dmg.git"
  },
  "keywords": [
    "actions",
    "apple",
    "macos",
    "dmg",
    "hdiutil",
    "codesign"
  ],
  "author": "Itty Bitty Apps Pty Ltd",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "~3.0.0",
    "@actions/exec": "~3.0.0"
  },
  "devDependencies": {
    "@types/node": "~26.6.4",
    "esbuild": "~0.28.0",
    "eslint": "~9.39.0",
    "eslint-plugin-github": "~6.0.0",
    "knip": "~6.5.0",
    "prettier": "~3.8.0",
    "typescript": "~6.0.0",
    "vite": "~8.3.3",
    "vitest": "~5.0.2"
  },
  "packageManager": "yarn@4.14.1"
}
